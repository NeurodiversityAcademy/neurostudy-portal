COGNITO_USER_POOL_ID=
COGNITO_PUBLIC_CLIENT_ID=
COGNITO_CONFIDENTIAL_CLIENT_ID=
COGNITO_CONFIDENTIAL_CLIENT_SECRET=
COGNITO_ISSUER=
NEXT_PUBLIC_HOST_URL=http://localhost:3000
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Auth.js v5 also accepts AUTH_SECRET / AUTH_URL (fallback to NEXTAUTH_* above)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
USER_TABLE_NAME=
ADMIN_EMAILS=
COURSES_TABLE_NAME=

# BotID search gate. Generate with: openssl rand -hex 32
# When set (32+ chars), the search page renders results only after BotID verification.
# Leave empty to keep search ungated (the Vercel Firewall rules still apply).
BOTID_COOKIE_SECRET=

# Demo pass: GUID → internal endorsed slug (JSON map, server-only)
# Homepage: /?demo=<guid> → single endorsed card (non-live providers only)
# Detail: /endorsedproviders/<guid>?demo=<same-guid> (non-live providers)
# Live providers: /endorsedproviders/<slug> (no demo pass required)
# No pass on / → live endorsed section only; slug paths for non-live → 404
ENDORSED_DEMO_ACCESS={"28484141-69ae-4eed-8d54-8a7522dd2c21":"academia"}

# Azure Monitor / Application Insights (server-only).
# When set, OpenTelemetry spans from API routes are exported to App Insights.
# Leave empty to keep local/CI telemetry offline; structured JSON logs still print.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Optional shared secret for GET /api/search/health (sent as x-health-token).
SEARCH_HEALTH_TOKEN=

# Provider search assist model (Azure AI Foundry).
# ASSIST_CACHE=off is the kill switch for the in-memory response cache.
ASSIST_API_URL=
ASSIST_API_KEY=
ASSIST_MODEL=
ASSIST_AUTH_HEADER=api-key
ASSIST_CACHE=on
